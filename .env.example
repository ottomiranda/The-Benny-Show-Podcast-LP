VITE_YT_API_KEY=your-youtube-data-api-v3-key
VITE_YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
VITE_BRAND_PITCH_URL=https://formspree.io/f/your-form-id

# Server-only — used by api/subscribe.ts (Vercel) and server/index.ts (DO Droplet)
MAILCHIMP_API_KEY=your-mailchimp-api-key-with-dc-suffix
MAILCHIMP_LIST_ID=your-audience-id
MAILCHIMP_DC=us14

# DO Droplet only — Express bind address (defaults: 127.0.0.1:3000)
PORT=3000
HOST=127.0.0.1
